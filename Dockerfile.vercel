FROM dunglas/frankenphp:php8.3-bookworm

RUN install-php-extensions \
    pdo_pgsql \
    pgsql \
    intl \
    zip \
    pcntl

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY . .

RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction

RUN php artisan storage:link || true

CMD ["sh", "-c", "php artisan config:cache && php artisan route:cache && php artisan view:cache && frankenphp php-server --root public --listen :${PORT:-80}"]